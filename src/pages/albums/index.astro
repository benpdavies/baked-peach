---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { getAllAlbums, getAlbumPhotos, albumUrl } from '../../lib/photos';

const albums = await getAllAlbums();
const albumsWithCover = await Promise.all(
  albums.map(async (album) => {
    const photos = await getAlbumPhotos(album.id);
    return { album, cover: photos[0], count: photos.length };
  })
);
---

<BaseLayout title="Albums" description="Browse photography by album.">
  <h1 class="page-title">Albums</h1>
  <p class="page-lede">Every photo lives in one of these collections.</p>

  <ul class="album-list">
    {
      albumsWithCover.map(({ album, cover, count }) => (
        <li class="album-list__item">
          <a href={albumUrl(album.id)} class="album-list__link">
            {cover && (
              <ResponsiveImage image={cover.data.image} alt="" layout="constrained" width={640} />
            )}
            <span class="album-list__caption">
              <span class="album-list__title">{album.data.title}</span>
              <span class="album-list__count">{count} photo{count === 1 ? '' : 's'}</span>
              {album.data.description && <span class="album-list__description">{album.data.description}</span>}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .album-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-lg);
  }

  .album-list__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .album-list__caption {
    display: block;
    padding-block: var(--space-sm);
  }

  .album-list__title {
    display: block;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .album-list__count {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    margin-block: 0.25rem;
  }

  .album-list__description {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    max-width: 30rem;
  }
</style>
