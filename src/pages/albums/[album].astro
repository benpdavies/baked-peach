---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { getAllAlbums, getAlbumPhotos } from '../../lib/photos';

export async function getStaticPaths() {
  const albums = await getAllAlbums();
  return Promise.all(
    albums.map(async (album) => ({
      params: { album: album.id },
      props: { album, photos: await getAlbumPhotos(album.id) },
    }))
  );
}

const { album, photos } = Astro.props;
---

<BaseLayout title={album.data.title} description={album.data.description ?? `${album.data.title} photos.`}>
  <h1 class="page-title">{album.data.title}</h1>
  {album.data.description && <p class="page-lede">{album.data.description}</p>}

  {
    photos.length > 0 ? (
      <Lightbox>
        <PhotoGrid photos={photos} />
      </Lightbox>
    ) : (
      <p class="page-lede">No photos in this album yet.</p>
    )
  }
</BaseLayout>
