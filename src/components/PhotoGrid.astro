---
import { getImage } from 'astro:assets';
import ResponsiveImage from './ResponsiveImage.astro';
import { photoLabel, photoMonthYear, photoSlug, type Photo } from '../lib/photos';

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;

const items = await Promise.all(
  photos.map(async (photo) => {
    const { width } = photo.data.image;
    const lightbox = await getImage({ src: photo.data.image, width: Math.min(width, 2560), format: 'webp', quality: 92 });
    return { photo, lightbox };
  })
);
---

<ol class="photos">
  {
    items.map(({ photo, lightbox }) => (
      <li class="photo" id={photoSlug(photo)}>
        <a
          href={lightbox.src}
          class="photo__link js-lightbox-item"
          data-lightbox-src={lightbox.src}
          data-lightbox-width={photo.data.image.width}
          data-lightbox-height={photo.data.image.height}
          data-lightbox-slug={photoSlug(photo)}
          data-lightbox-title={photoLabel(photo)}
          data-lightbox-location={photo.data.location ?? ''}
          data-lightbox-fallback-title={photo.data.title}
          data-lightbox-caption={photo.data.description ?? ''}
          data-lightbox-date={photoMonthYear(photo)}
        >
          <ResponsiveImage image={photo.data.image} alt={photoLabel(photo)} layout="constrained" width={2400} sizes="(min-width: 48rem) 50vw, 100vw" />
        </a>
      </li>
    ))
  }
</ol>

<style>
  .photos {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    /* Half the page on larger screens; full width on phones. */
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  @media (min-width: 48rem) {
    .photos {
      width: 50%;
    }
  }

  .photo__link {
    display: block;
    color: inherit;
    text-decoration: none;
    box-shadow: var(--shadow-print);
    transition: box-shadow 0.35s ease;
  }

  .photo__link:hover {
    box-shadow: var(--shadow-print-raised);
  }

  .photo__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  /* Hidden while the lightbox shows it, so the print looks lifted off the page. */
  .photo__link.is-lifted {
    visibility: hidden;
  }
</style>
